# Copy to .env for local development. This file contains placeholders only.
CORPORA_TEXT_CHECK_BIN=corpora-text-check
# Converter commands and Rust helpers are installed in the Vercel container.
# CORPORA_TEI_TO_TF_BIN=tei-to-tf
# CORPORA_EPUB_TO_TF_BIN=epub-to-tf
# CORPORA_PDF_TO_TF_BIN=pdf-to-tf
# CORPORA_EPUB_CHECK_BIN=corpora-epub-check
# CORPORA_PDF_EXTRACT_BIN=corpora-pdf-extract
# CORPORA_VALIDATE_BIN=corpora-validate
# Set this to a directory installed by corpora-core's dictionary installer to enable spelling.
# CORPORA_DICTIONARIES_DIR=REPLACE_ME
# Set a bearer token before exposing the API on a public host.
# CORPORA_API_TOKEN=REPLACE_ME
# Supabase user JWTs are verified against this project's asymmetric signing keys.
# PROJECT_REF=REPLACE_ME
# SUPABASE_JWKS_URL=REPLACE_ME
# SUPABASE_JWT_ISSUER=REPLACE_ME
# SUPABASE_JWT_AUDIENCE=authenticated
# Durable /v1/ingest jobs use the existing private conversion_jobs table and job bucket.
# SUPABASE_URL=REPLACE_ME
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# SUPABASE_JOBS_BUCKET=REPLACE_ME
# Storage defaults to the legacy Hub backend; use supabase for the owner-scoped library.
# STORAGE_BACKEND=huggingface
# HF_STORAGE_REPO=REPLACE_ME
# HF_STORAGE_REPO_TYPE=dataset
# HF_TOKEN=REPLACE_ME  # read-only access to the configured Hub repository
# HF_STORAGE_WRITE_TOKEN=REPLACE_ME  # separate write-scoped key for publish/delete
# Existing private corpus library bucket when STORAGE_BACKEND=supabase.
# SUPABASE_STORAGE_BUCKET=REPLACE_ME
# Optional separate Python environment with corpora-api and corpora-admin[docling].
# CORPORA_INGEST_WORKER_PYTHON=REPLACE_ME

# Set these in the Vercel docs project to enable bounded AI chat.
# AI_GATEWAY_API_KEY=REPLACE_ME
# UPSTASH_REDIS_REST_URL=REPLACE_ME
# UPSTASH_REDIS_REST_TOKEN=REPLACE_ME
